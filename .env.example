# Хост приложения (нужно прописать в /etc/hosts: 127.0.0.1 laravel.docker.local)
APP_HOST=convertal.docker.local

# Путь внутри контейнера, куда docker-compose монтирует корень репозитория (./:${APP_PATH})
APP_PATH=/pub/www/app

APP_NAME=Convertal
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_ENV=local
APP_KEY=base64:i0U1lu4eWxsh+z7BAmgSHpV1i9di5khacP3u8zinXLY=
APP_DEBUG=true
APP_URL=http://convertal.docker.local

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Образ контейнера проверяет эти переменные при старте и без них не запускается.
# Само приложение к СУБД не обращается: сессия, кэш и очередь живут в файлах.
# sqlite в памяти — контейнер не ждёт MariaDB и не создаёт файл базы.
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=:memory:
DB_USERNAME=laravel
DB_PASSWORD=secret

# Если установить значение 1, то artisan schedule:run будет выполняться раз в минуту
# Если установить значение 0, то планировщик Laravel не будет выполняться
LARAVEL_CRON_ENABLED=0
